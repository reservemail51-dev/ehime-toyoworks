// Cloudflare Workers の設定（静的サイトとして public フォルダだけを公開する）
{
  "name": "ehime-toyoworks",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true
}
